include README.md CITATION.cff THIRD_PARTY.md CONTRIBUTING.md pipeline.py
include LICENSE NOTICE
include CHANGELOG.md
include pyproject.toml MANIFEST.in
recursive-include src *.py *.md
recursive-include config *.yaml *.rst .gitignore
recursive-include templates *.template.json README.md
recursive-include catalog *.json *.md
recursive-include docs *.md
recursive-include scripts *.py *.md
recursive-include requirements *.txt *.md
recursive-include results *.md *.zip SHA256SUMS
prune local_notes
prune runs
prune logs
prune outputs
global-exclude __pycache__ *.py[cod]
exclude templates/local.*
